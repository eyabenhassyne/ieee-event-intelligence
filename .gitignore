# Private and raw data
data/raw/*
data/staging/*
data/processed/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/processed/.gitkeep

# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs
*.log
etl/logs/*
!etl/logs/.gitkeep

# Power BI temporary files
*.pbit.tmp
*.pbix.tmp

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Database dumps
*.sql.gz
*.dump
*.backup
